	<name>Shuffle Lines</name>
	<version>1.1</version>
	<description>Shuffles (randomize) selected lines</description>
	<author>HippoEDIT.com</author>
	<email>supportbox@hippoedit.com</email>
	<homepage>http://wiki.hippoedit.com/plugins/shuffle_lines</homepage>
	<memo></memo>
	<install>
		<readme type="inline">This will install Shuffle Lines plugin for HippoEDIT.</readme>
		<require-file name="shuffle lines.hejs" destination="%{plugins}%/shuffle lines.hejs" />
