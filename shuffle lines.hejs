function shuffle(array) {
  var currentIndex = array.length, temporaryValue, randomIndex ;

  // While there remain elements to shuffle...
  while (0 !== currentIndex) {

    // Pick a remaining element...
    randomIndex = Math.floor(Math.random() * currentIndex);
    currentIndex -= 1;

    // And swap it with the current element.
    temporaryValue = array[currentIndex];
    array[currentIndex] = array[randomIndex];
    array[randomIndex] = temporaryValue;
  }

  return array;
}

var vCommand = new Command("Edit.Shuffle", "Shuffle Lines", "Shuffle (randomize) selected lines", nIcon);
vCommand.onEnabled = function() {
	return ActiveDocument !== null && ActiveDocument.ReadOnly !== true && !ActiveView.Selection.IsEmpty;
}
vCommand.onExecute = function() {
	__include("he_utils.js");
	var sel = ActiveView.Selection;
	if ( sel.End.Pos && sel.End.Line != ActiveDocument.LineCount - 1 )
		sel.End = new Position(sel.End.Line + 1, 0);
		
	var text = shuffle(ax2js(ActiveDocument.GetLines(sel, true))).join("");
	ActiveView.Position = ActiveDocument.ReplaceText(sel, text, AddUndoActionType("Shuffle lines"));
}

Application.RegisterCommand(vCommand);

////////////////////////////////////////////////////////////////////////
// Update main menu with our items
Application.onInitMainMenu = function (bUpdate){
	if ( !bUpdate ) {
		var menu_location = this.GetMenuItemPos("Edit.SortDescending");
		if (menu_location.Menu !== null && menu_location.Position != -1) {
			menu_location.Menu.InsertItem(menu_location.Position + 1, "", vCommand);
		}
	}
}